{
  "name": "@scalable.software/panel",
  "version": "0.4.0",
  "description": "A theme-aware web component that holds content in a window under a taskbar: the end user moves, resizes, pins, minimizes, maximizes, restores and closes it.",
  "keywords": [
    "web component"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "clean.test": "node ./tasks/clean.test.mjs",
    "pretest": "npm run clean.test && tsc --project tsconfig.test.json",
    "test": "karma start",
    "posttest": "npm run clean.test",
    "prebuild": "node ./tasks/clean.build.mjs",
    "build": "tsc --project tsconfig.build.json",
    "postbuild": "node ./tasks/copy.build.mjs",
    "preserve": "npm run build",
    "serve": "web-dev-server --open /demo/index.html",
    "document": "npx typedoc --tsconfig tsconfig.test.json",
    "prepublish": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scalable-software/panel.git"
  },
  "author": "Scalable.Software",
  "license": "CC-BY-NC-SA-4.0",
  "bugs": {
    "url": "https://github.com/scalable-software/panel/issues"
  },
  "homepage": "https://github.com/scalable-software/panel#readme",
  "devDependencies": {
    "@types/jasmine": "^5.1.4",
    "@web/dev-server": "^0.4.6",
    "jasmine": "^5.1.0",
    "karma": "^6.4.3",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage-istanbul-instrumenter": "^1.0.4",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jasmine": "^5.1.0",
    "karma-spec-reporter": "^0.0.36",
    "typedoc": "^0.28.20",
    "typedoc-plugin-merge-modules": "^7.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@scalable.software/close": "^0.1.1",
    "@scalable.software/component": "^0.7.0",
    "@scalable.software/maximize": "^0.1.1",
    "@scalable.software/minimize": "^0.1.1",
    "@scalable.software/pin": "^0.3.0",
    "@scalable.software/restore": "^0.1.1",
    "@scalable.software/taskbar": "^0.2.0"
  }
}
